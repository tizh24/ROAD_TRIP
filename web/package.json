{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:auth && npm run test:api && npm run test:community && npm run test:partner && npm run test:billing && npm run test:analytics",
    "test:auth": "node --experimental-strip-types --test src/lib/auth/*.test.mjs",
    "test:api": "node --experimental-strip-types --test src/features/trip-planning/api/*.test.mjs",
    "test:community": "node --experimental-strip-types --test src/features/community/api/*.test.mjs",
    "test:partner": "node --experimental-strip-types --test src/features/partner/api/*.test.mjs",
    "test:billing": "node --experimental-strip-types --test src/features/billing/api/*.test.mjs",
    "test:analytics": "node --experimental-strip-types --test src/lib/analytics/*.test.mjs",
    "test:e2e": "playwright test",
    "test:staging:public": "node scripts/verify-staging.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.30.0",
    "next": "16.3.8",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
