# Copy to .env.hosted.local and replace every placeholder. Never commit that file.
NODE_ENV=development
LOG_LEVEL=debug

# All Supabase values must point to the same hosted project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Required only when your Supabase project's access tokens use legacy HS256 signing.
# Dashboard: Project Settings -> API -> JWT Settings -> Legacy JWT secret.
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVER_ONLY
DATABASE_URL=postgresql://postgres.your-project:CHANGE_ME@aws-0-your-region.pooler.supabase.com:5432/postgres

# Hosted Redis (for example an Upstash TLS URL). This replaces local Redis/Docker.
REDIS_URL=rediss://default:CHANGE_ME@your-redis-host:6379
REDIS_CACHE_PREFIX=roadtrip:cache
REDIS_RATE_LIMIT_PREFIX=roadtrip:rate-limit
BULLMQ_QUEUE_NAME=integration-events
BULLMQ_QUEUE_PREFIX=roadtrip:bullmq
BULLMQ_CONCURRENCY=5
BULLMQ_ATTEMPTS=5
BULLMQ_BACKOFF_MS=1000
BULLMQ_FAILED_RETENTION=1000

# Native process topology. The launcher applies these safe loopback values.
CORE_TRIP_SERVICE_URL=http://127.0.0.1:4101
GEO_LOCATION_SERVICE_URL=http://127.0.0.1:4102
INTERNAL_SERVICE_TOKEN=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT_BYTES=1048576
UPSTREAM_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=300
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_NAME=rt_access
AUTH_REFRESH_COOKIE_NAME=rt_refresh
CSRF_COOKIE_NAME=rt_csrf
# Set to tripz.vn when web and API use sibling production domains.
# AUTH_COOKIE_DOMAIN=tripz.vn
GEO_SEARCH_CACHE_TTL_SECONDS=300
GEO_ROUTE_CACHE_TTL_SECONDS=120
LOCATIONIQ_BASE_URL=https://us1.locationiq.com
LOCATIONIQ_API_KEY=CHANGE_ME
LOCATIONIQ_TIMEOUT_MS=5000
