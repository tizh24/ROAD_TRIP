{
  "name": "roadtrip-backend-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --filter=api-gateway --filter=core-trip-service --filter=geo-location-service --filter=notification-worker --filter=@roadtrip/config --filter=@roadtrip/contracts --filter=@roadtrip/health --filter=@roadtrip/observability --filter=@roadtrip/db-client --filter=@roadtrip/shared-types",
    "lint:fix": "turbo run lint:fix --filter=api-gateway --filter=core-trip-service --filter=geo-location-service --filter=notification-worker",
    "typecheck": "turbo run typecheck --filter=api-gateway --filter=core-trip-service --filter=geo-location-service --filter=notification-worker --filter=@roadtrip/config --filter=@roadtrip/contracts --filter=@roadtrip/health --filter=@roadtrip/observability --filter=@roadtrip/db-client --filter=@roadtrip/shared-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "platform:config": "docker compose -f infrastructure/docker-compose.yml config --quiet",
    "platform:up": "docker compose -f infrastructure/docker-compose.yml up --build --wait",
    "platform:up:tools": "docker compose -f infrastructure/docker-compose.yml --profile development-tools up --build --wait",
    "platform:down": "docker compose -f infrastructure/docker-compose.yml down",
    "verify:redis-durability": "node scripts/verify-redis-durability.mjs",
    "verify:platform-shutdown": "node scripts/verify-platform-shutdown.mjs",
    "db:types": "supabase gen types typescript --local --schema public,trip_schema,notification_schema > packages/db-client/src/database.types.ts && prettier --write packages/db-client/src/database.types.ts",
    "check:cycles": "madge --circular --extensions ts apps packages",
    "format": "prettier --write \"*.{json,mjs}\" \"scripts/*.mjs\" \"apps/{api-gateway,core-trip-service,geo-location-service,notification-worker}/**/*.{ts,json,mjs}\" \"packages/{config,contracts,db-client,health,observability,shared-types}/**/*.{ts,json,mjs}\"",
    "format:check": "prettier --check \"*.{json,mjs}\" \"scripts/*.mjs\" \"apps/{api-gateway,core-trip-service,geo-location-service,notification-worker}/**/*.{ts,json,mjs}\" \"packages/{config,contracts,db-client,health,observability,shared-types}/**/*.{ts,json,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "bullmq": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "ioredis": "^5.11.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "supabase": "2.114.0",
    "turbo": "^2.10.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
