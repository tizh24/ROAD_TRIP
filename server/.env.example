# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# Supabase Auth (public project metadata; never put the service-role key here)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# PostgreSQL (replace locally; production uses a secret manager)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres

# Internal services
CORE_TRIP_SERVICE_URL=http://localhost:4101
GEO_LOCATION_SERVICE_URL=http://localhost:4102
INTERNAL_SERVICE_TOKEN=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=300

# Redis connection with isolated namespaces for each workload
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_PREFIX=roadtrip:cache
REDIS_RATE_LIMIT_PREFIX=roadtrip:rate-limit
GEO_CACHE_TTL_SECONDS=300
BULLMQ_QUEUE_NAME=integration-events
BULLMQ_QUEUE_PREFIX=roadtrip:bullmq
BULLMQ_CONCURRENCY=5
BULLMQ_ATTEMPTS=5
BULLMQ_BACKOFF_MS=1000
BULLMQ_FAILED_RETENTION=1000

# VietMap server-side adapter
VIETMAP_BASE_URL=https://maps.vietmap.vn
VIETMAP_API_KEY=CHANGE_ME
VIETMAP_TIMEOUT_MS=5000

# Default local ports: Gateway 4100, Core Trip 4101, Geo 4102, Worker health 4105.
# Set PORT in the environment of each deployable rather than sharing one value.
